# Stripe — use a restricted key (rk_) with only Checkout/Webhooks permissions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage (Vercel KV / Upstash Redis)
# Provide both to enable live mode; otherwise the app runs in demo mode.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override defaults for the board
# BID_TAKEOVER_PRICE_CENTS=100000
# BID_MIN_ENTER_CENTS=10000
# BID_MAX_ENTRIES=50
